    table.header([*Модел*], [*Макро F1 (42 обележја)*], [*Макро F1 (30 обележја)*], [*Δ*]),
    [Логистичка регресија], [0,744], [0,704], [−0,040],
    [Random Forest], [0,770], [0,744], [−0,026],
    [Gradient Boosting], [0,758], [0,731], [−0,027],
